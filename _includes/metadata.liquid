{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}

{% comment %} Social handles live in _data/socials.yml, not in _config.yml {% endcomment %}
{% assign socials = site.data.socials %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>
  {% if site.title == 'blank' %}
    {% capture title %}{{ author_name }}{% endcapture %}
  {% else %}
    {% capture title %}{{ site.title }}{% endcapture %}
  {% endif %}
  {% if page.url == '/blog/index.html' %}
    {{ page.title }} | {{ title }}
  {% elsif page.title != 'blank' and page.url != '/' %}
    {% if page.title == null or page.title == '' %}
      {{ page.date | date: '%Y' }} | {{ title }}
    {% else %}
      {{ page.title }} | {{ title }}
    {% endif %}
  {% else %}
    {{ title }}
  {% endif %}
</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{% if page.description %}{{ page.description }}{% else %}{{ site.description }}{% endif %}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ title }}">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if page.title %}{{ title }} | {{ page.title }}{% else %}{{ title }}{% endif %}">
  <meta property="og:url" content="{{ page.url | prepend: site.baseurl | prepend: site.url | remove_first: 'index.html' }}">
  <meta property="og:description" content="{% if page.description %}{{ page.description }}{% else %}{{ site.description }}{% endif %}">
  {% if page.og_image or site.og_image %}
    <meta property="og:image" content="{% if page.og_image %}{{ page.og_image }}{% else %}{{ site.og_image }}{% endif %}">
  {% endif %}
  <meta property="og:locale" content="{{ site.lang }}">

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if page.title %}{{ page.title }}{% else %}{{ title }}{% endif %}">
  <meta name="twitter:description" content="{% if page.description %}{{ page.description }}{% else %}{{ site.description }}{% endif %}">
  {% if page.og_image or site.og_image %}
    <meta name="twitter:image" content="{% if page.og_image %}{{ page.og_image }}{% else %}{{ site.og_image }}{% endif %}">
  {% endif %}
  {% if socials.x_username %}
    <meta name="twitter:site" content="@{{ socials.x_username }}">
    <meta name="twitter:creator" content="@{{ socials.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {% comment %} Social links generator for "sameAs schema" {% endcomment %}
  {% assign sameaslinks = '' | split: ',' %}
  {% if socials.orcid_id %}
    {% capture link %}https://orcid.org/{{ socials.orcid_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.scholar_userid %}
    {% capture link %}https://scholar.google.com/citations?user={{ socials.scholar_userid }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.semanticscholar_id %}
    {% capture link %}https://www.semanticscholar.org/author/{{ socials.semanticscholar_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.publons_id %}
    {% capture link %}https://publons.com/a/{{ socials.publons_id }}/{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.lattes_id %}
    {% capture link %}http://lattes.cnpq.br/{{ socials.lattes_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.osf_id %}
    {% capture link %}https://osf.io/{{ socials.osf_id }}/{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.research_gate_profile %}
    {% capture link %}https://www.researchgate.net/profile/{{ socials.research_gate_profile }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.scopus_id %}
    {% capture link %}https://www.scopus.com/authid/detail.uri?authorId={{ socials.scopus_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.github_username %}
    {% capture link %}https://github.com/{{ socials.github_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.telegram_username %}
    {% capture link %}https://telegram.me/{{ socials.telegram_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.linkedin_username %}
    {% capture link %}https://www.linkedin.com/in/{{ socials.linkedin_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.x_username %}
    {% capture link %}https://twitter.com/{{ socials.x_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.mastodon_username %}
    {% capture link %}https://{{ socials.mastodon_username  }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.medium_username %}
    {% capture link %}https://medium.com/@{{ socials.medium_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.quora_username %}
    {% capture link %}https://www.quora.com/profile/{{ socials.quora_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.blogger_url %}
    {% capture link %}{{ socials.blogger_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.work_url %}
    {% capture link %}{{ socials.work_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.wikidata_id %}
    {% capture link %}https://www.wikidata.org/wiki/{{ socials.wikidata_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.wikipedia_id %}
    {% capture link %}https://wikipedia.org/wiki/User:{{ socials.wikipedia_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.strava_userid %}
    {% capture link %}https://www.strava.com/athletes/{{ socials.strava_userid }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.keybase_username %}
    {% capture link %}https://keybase.io/{{ socials.keybase_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.gitlab_username %}
    {% capture link %}https://gitlab.com/{{ socials.gitlab_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.dblp_url %}
    {% capture link %}{{ socials.dblp_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.stackoverflow_id %}
    {% capture link %}https://stackoverflow.com/users/{{ socials.stackoverflow_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.kaggle_id %}
    {% capture link %}https://www.kaggle.com/{{ socials.kaggle_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.lastfm_id %}
    {% capture link %}https://www.last.fm/user/{{ socials.lastfm_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.spotify_id %}
    {% capture link %}https://open.spotify.com/user/{{ socials.spotify_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.pinterest_id %}
    {% capture link %}https://www.pinterest.com/{{ socials.pinterest_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.unsplash_id %}
    {% capture link %}https://unsplash.com/@{{ socials.unsplash_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.instagram_id %}
    {% capture link %}https://instagram.com/{{ socials.instagram_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.facebook_id %}
    {% capture link %}https://facebook.com/{{ socials.facebook_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.youtube_id %}
    {% capture link %}https://youtube.com/@{{ socials.youtube_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.discord_id %}
    {% capture link %}https://discord.com/users/{{ socials.discord_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.zotero_username %}
    {% capture link %}https://www.zotero.org/{{ socials.zotero_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if sameaslinks != blank %}
    {% assign sameaslinks = sameaslinks | split: '' %}
  {% endif %}

  <script type="application/ld+json">
    {
        "author":
        {
            "@type": "Person",
            "name": "{{ author_name }}"
        },
        "url": "{{ page.url | prepend: site.baseurl | prepend: site.url }}",
        "@type": "{% if is_blog_post %}BlogPosting{% else %}WebSite{% endif %}",
        "description": "{% if page.description %}{{ page.description }}{% else if site.description %}{{ site.description }}{% endif %}",
        "headline": "{% if page.title %}{{ page.title }}{% else %}{{ site.title }}{% endif %}",
        {% if sameaslinks != blank %}
        "sameAs": {{ sameaslinks }},
        {% endif %}
        "name": "{{ author_name }}",
        "@context": "https://schema.org"
    }
  </script>
{% endif %}
